# Copy this file to ".env" and fill in your own values. Never share your real .env file.

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# How often to check your inbox, in seconds. 300 = every 5 minutes.
POLL_INTERVAL_SECONDS=300

# How many recent inbox emails to look at on each check (keeps API usage/cost bounded).
MAX_EMAILS_PER_CHECK=25

# Optional: restrict scanning to emails newer than N days on the very first run,
# so you don't re-process your entire email history the first time you start it.
INITIAL_LOOKBACK_DAYS=14

# Optional phone push notifications via ntfy.sh (free, no account needed).
# Leave NTFY_TOPIC blank to skip phone push notifications (desktop popups
# still work either way). See README.md for the 2-minute setup.
# Pick a long, hard-to-guess topic name -- anyone who knows it can read your
# notifications, since ntfy.sh topics aren't private by default.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
